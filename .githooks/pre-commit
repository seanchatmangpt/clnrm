#!/usr/bin/env bash
# Pre-commit hook for fast quality checks
# Runs: TOML validation, clippy, basic checks
# Target: < 30 seconds for fast developer feedback

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
BOLD='\033[1m'

echo -e "${BOLD}🔍 Running pre-commit quality checks...${NC}\n"

# Track timing
START_TIME=$(date +%s)

# =============================================================================
# 1. TOML Validation (Fast: ~2-5 seconds)
# =============================================================================
echo -e "${YELLOW}📝 Validating TOML examples...${NC}"
if [ -f "scripts/doc-validation/validate-toml-examples.sh" ]; then
    if ! bash scripts/doc-validation/validate-toml-examples.sh; then
        echo -e "${RED}✗ TOML validation failed${NC}"
        echo -e "${YELLOW}Fix: Review TOML syntax errors above${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ TOML examples valid${NC}\n"
else
    echo -e "${YELLOW}⚠ TOML validation script not found, skipping${NC}\n"
fi

# =============================================================================
# 2. Cargo Format Check (Fast: ~1-2 seconds)
# =============================================================================
echo -e "${YELLOW}🎨 Checking code formatting...${NC}"
if ! cargo fmt --all -- --check > /dev/null 2>&1; then
    echo -e "${RED}✗ Code formatting check failed${NC}"
    echo -e "${YELLOW}Fix: Run 'cargo fmt' to auto-format code${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Code formatting correct${NC}\n"

# =============================================================================
# 3. Cargo Clippy (Medium: ~10-20 seconds with cache)
# =============================================================================
echo -e "${YELLOW}🔧 Running clippy linter...${NC}"

# Check only changed files if possible (optimization)
# Fall back to full check if git diff fails
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)

if [ -z "$CHANGED_FILES" ]; then
    echo -e "${GREEN}✓ No Rust files changed${NC}\n"
else
    # Run clippy on workspace (fast with incremental compilation)
    if ! cargo clippy --workspace --all-targets --all-features -- -D warnings 2>&1; then
        echo -e "${RED}✗ Clippy found issues${NC}"
        echo -e "${YELLOW}Fix: Address clippy warnings above${NC}"
        echo -e "${YELLOW}Tip: Run 'cargo clippy --fix' for auto-fixes${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ Clippy passed${NC}\n"
fi

# =============================================================================
# 4. Basic Build Check (Fast: ~5-10 seconds with cache)
# =============================================================================
echo -e "${YELLOW}🔨 Verifying build...${NC}"
if ! cargo check --workspace --all-features > /dev/null 2>&1; then
    echo -e "${RED}✗ Build check failed${NC}"
    echo -e "${YELLOW}Fix: Run 'cargo check' to see errors${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Build check passed${NC}\n"

# =============================================================================
# 5. Check for Common Issues
# =============================================================================
echo -e "${YELLOW}🔍 Checking for common issues...${NC}"

# Check for unwrap/expect in production code (excluding tests)
UNWRAP_COUNT=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '\.rs$' | \
    grep -v 'tests/' | \
    xargs grep -n '\.unwrap()\|\.expect(' 2>/dev/null | \
    grep -v '#\[cfg(test)\]' | \
    wc -l | tr -d ' ')

if [ "$UNWRAP_COUNT" -gt 0 ]; then
    echo -e "${RED}✗ Found .unwrap() or .expect() in production code${NC}"
    echo -e "${YELLOW}Fix: Use proper error handling with Result<T, E>${NC}"
    git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.rs$' | \
        grep -v 'tests/' | \
        xargs grep -n '\.unwrap()\|\.expect(' | \
        head -10
    exit 1
fi

# Check for println! in production code (should use tracing)
PRINTLN_COUNT=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -E '\.rs$' | \
    grep -v 'tests/' | \
    grep -v 'main.rs' | \
    xargs grep -n 'println!' 2>/dev/null | \
    grep -v '#\[cfg(test)\]' | \
    wc -l | tr -d ' ')

if [ "$PRINTLN_COUNT" -gt 0 ]; then
    echo -e "${YELLOW}⚠ Found println! in production code (consider using tracing)${NC}"
    git diff --cached --name-only --diff-filter=ACM | \
        grep -E '\.rs$' | \
        grep -v 'tests/' | \
        grep -v 'main.rs' | \
        xargs grep -n 'println!' | \
        head -5
    echo ""
fi

echo -e "${GREEN}✓ Common issues check passed${NC}\n"

# =============================================================================
# Summary
# =============================================================================
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo -e "${GREEN}${BOLD}✓ All pre-commit checks passed in ${DURATION}s${NC}"
echo -e "${GREEN}Ready to commit!${NC}\n"

exit 0
