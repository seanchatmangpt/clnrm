#!/usr/bin/env bash
# Pre-push hook for comprehensive validation
# Runs: Full test suite, Weaver schema checks, integration tests
# Target: Complete validation before pushing to remote
#
# NOTE: This hook can be slow (~60-120 seconds). To skip it:
#   git push --no-verify origin branch

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color
BOLD='\033[1m'

echo -e "${BOLD}🚀 Running pre-push validation checks...${NC}\n"

# Track timing
START_TIME=$(date +%s)

# =============================================================================
# 1. Full Cargo Test Suite (Slow: ~30-60 seconds)
# =============================================================================
echo -e "${YELLOW}🧪 Running full test suite...${NC}"
echo -e "${BLUE}This may take a minute...${NC}\n"

# Allow skipping tests with SKIP_TESTS env var (for local development)
if [ "$SKIP_TESTS" = "1" ]; then
    echo -e "${YELLOW}⚠ Skipping tests (SKIP_TESTS=1)${NC}\n"
else
    if ! cargo test --workspace --all-features 2>&1; then
        echo -e "${RED}✗ Test suite failed${NC}"
        echo -e "${YELLOW}Fix: Address test failures above${NC}"
        exit 1
    fi
    echo -e "${GREEN}✓ All tests passed${NC}\n"
fi

# =============================================================================
# 2. Weaver Schema Validation (if available)
# =============================================================================
echo -e "${YELLOW}📋 Checking Weaver schema validation...${NC}"

if command -v weaver &> /dev/null; then
    echo -e "${BLUE}Weaver found, running schema checks...${NC}\n"

    # Check if registry directory exists
    if [ -d "registry" ]; then
        # Schema definition check
        echo -e "${YELLOW}  → Validating schema definitions...${NC}"
        if ! weaver registry check -r registry/ 2>&1; then
            echo -e "${RED}✗ Weaver schema check failed${NC}"
            echo -e "${YELLOW}Fix: Review schema errors above${NC}"
            exit 1
        fi
        echo -e "${GREEN}  ✓ Schema definitions valid${NC}\n"

        # Live telemetry check (if OTEL is running)
        echo -e "${YELLOW}  → Checking live telemetry conformance...${NC}"
        if weaver registry live-check --registry registry/ 2>&1; then
            echo -e "${GREEN}  ✓ Live telemetry conforms to schema${NC}\n"
        else
            echo -e "${YELLOW}  ⚠ Live telemetry check failed (OTEL may not be running)${NC}"
            echo -e "${YELLOW}  This is acceptable for local commits, but ensure OTEL works before release${NC}\n"
        fi
    else
        echo -e "${YELLOW}  ⚠ No registry/ directory found${NC}\n"
    fi
else
    echo -e "${YELLOW}⚠ Weaver not installed, skipping schema validation${NC}"
    echo -e "${BLUE}Install: cargo install weaver${NC}\n"
fi

# =============================================================================
# 3. Integration Test Validation (if Homebrew installation exists)
# =============================================================================
echo -e "${YELLOW}🔄 Checking integration tests...${NC}"

if command -v clnrm &> /dev/null; then
    echo -e "${BLUE}clnrm CLI found, running self-test...${NC}\n"

    # Run basic self-test
    if clnrm self-test 2>&1 | head -20; then
        echo -e "${GREEN}✓ Self-test passed${NC}\n"
    else
        echo -e "${YELLOW}⚠ Self-test had issues (may need rebuild)${NC}"
        echo -e "${BLUE}Consider running: cargo build --release && brew reinstall clnrm${NC}\n"
    fi
else
    echo -e "${YELLOW}⚠ clnrm not installed via Homebrew${NC}"
    echo -e "${BLUE}Install: brew install clnrm${NC}\n"
fi

# =============================================================================
# 4. Build with All Features (Production Configuration)
# =============================================================================
echo -e "${YELLOW}🏗️  Building with production features...${NC}"

if ! cargo build --release --features otel 2>&1 | tail -20; then
    echo -e "${RED}✗ Production build failed${NC}"
    echo -e "${YELLOW}Fix: Address build errors above${NC}"
    exit 1
fi
echo -e "${GREEN}✓ Production build successful${NC}\n"

# =============================================================================
# 5. Documentation Build Check
# =============================================================================
echo -e "${YELLOW}📚 Checking documentation...${NC}"

if ! cargo doc --workspace --all-features --no-deps 2>&1 | tail -10; then
    echo -e "${YELLOW}⚠ Documentation build had warnings${NC}\n"
else
    echo -e "${GREEN}✓ Documentation builds cleanly${NC}\n"
fi

# =============================================================================
# 6. Check for Uncommitted Changes
# =============================================================================
echo -e "${YELLOW}🔍 Checking for uncommitted changes...${NC}"

if ! git diff-index --quiet HEAD --; then
    echo -e "${YELLOW}⚠ Warning: You have uncommitted changes${NC}"
    echo -e "${BLUE}Consider committing all changes before pushing${NC}\n"
else
    echo -e "${GREEN}✓ Working directory clean${NC}\n"
fi

# =============================================================================
# 7. Branch Protection Checks
# =============================================================================
echo -e "${YELLOW}🌿 Checking branch...${NC}"

CURRENT_BRANCH=$(git branch --show-current)

if [ "$CURRENT_BRANCH" = "master" ] || [ "$CURRENT_BRANCH" = "main" ]; then
    echo -e "${YELLOW}⚠ Warning: Pushing directly to ${CURRENT_BRANCH}${NC}"
    echo -e "${BLUE}Consider using feature branches and pull requests${NC}\n"

    # Ask for confirmation
    read -p "Continue pushing to ${CURRENT_BRANCH}? (y/N) " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${RED}Push aborted${NC}"
        exit 1
    fi
else
    echo -e "${GREEN}✓ Pushing to feature branch: ${CURRENT_BRANCH}${NC}\n"
fi

# =============================================================================
# 8. Final Checklist
# =============================================================================
echo -e "${BOLD}${BLUE}Pre-push Checklist:${NC}"
echo -e "${GREEN}✓ Full test suite passed${NC}"
echo -e "${GREEN}✓ Production build successful${NC}"
if command -v weaver &> /dev/null && [ -d "registry" ]; then
    echo -e "${GREEN}✓ Weaver schema validation passed${NC}"
fi
if command -v clnrm &> /dev/null; then
    echo -e "${GREEN}✓ Integration tests checked${NC}"
fi
echo ""

# =============================================================================
# Summary
# =============================================================================
END_TIME=$(date +%s)
DURATION=$((END_TIME - START_TIME))

echo -e "${GREEN}${BOLD}✓ All pre-push checks passed in ${DURATION}s${NC}"
echo -e "${GREEN}Safe to push!${NC}\n"

exit 0
