# =============================================================================
# gVisor-Compatible Self-Test Dockerfile for clnrm
# KAIZEN PRINCIPLES: Optimized for sandbox security + build efficiency
# =============================================================================
# GENCHI GENBUTSU: This Dockerfile is engineered for:
# - gVisor runtime compatibility with restricted syscalls
# - Multi-stage build with layer caching optimization
# - Non-root user security hardening
# - Minimal attack surface in sandbox
#
# Build: docker build -f Dockerfile.clnrm-self-test -t clnrm-self-test:latest .
# Run (gVisor): docker run --runtime=runsc --rm clnrm-self-test:latest --version
# =============================================================================

# Stage 1: Builder - Compile clnrm with release optimizations
# NOTE: gVisor supports multi-stage builds and all Linux compiler operations
FROM rust:1.75-slim-bookworm AS builder

LABEL stage=builder
LABEL gvisor-compatible="true"
LABEL build-purpose="compile-clnrm-with-otel"

# Install build dependencies
# NOTE: All standard Linux build tools are fully supported by gVisor
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set working directory for build
WORKDIR /build

# Copy workspace configuration and manifests first (leverage Docker cache)
# MUDA ELIMINATION: Separate manifest copy enables dependency-only rebuild caching
COPY Cargo.toml Cargo.lock ./
COPY crates/clnrm/Cargo.toml ./crates/clnrm/
COPY crates/clnrm-core/Cargo.toml ./crates/clnrm-core/
COPY crates/clnrm-shared/Cargo.toml ./crates/clnrm-shared/

# Create dummy source files to cache dependencies
# JUST-IN-TIME: Only compile dependencies once; reuse across source changes
RUN mkdir -p crates/clnrm/src crates/clnrm-core/src crates/clnrm-shared/src && \
    echo "fn main() {}" > crates/clnrm/src/main.rs && \
    echo "pub fn dummy() {}" > crates/clnrm-core/src/lib.rs && \
    echo "pub fn dummy() {}" > crates/clnrm-shared/src/lib.rs

# Build dependencies only (cached layer)
# NOTE: This layer is reused when only source changes
RUN cargo build --release --bin clnrm && \
    rm -rf crates/*/src

# Copy actual source code
COPY crates/ ./crates/

# Build production binary with OTEL features
# NOTE: This invalidates cache when source changes but not dependencies
# MUDA ELIMINATION: Binary stripping reduces image size and attack surface
RUN cargo build --release --bin clnrm --features otel && \
    strip target/release/clnrm

# =============================================================================
# Stage 2: Runtime - gVisor-optimized minimal image for hermetic testing
# =============================================================================
FROM debian:bookworm-slim AS runtime

LABEL maintainer="clnrm"
LABEL gvisor-compatible="true"
LABEL gvisor-runtime="runsc"
LABEL security-model="sandbox"
LABEL description="gVisor-optimized clnrm self-test runtime"

# Install minimal runtime dependencies
# - ca-certificates: For HTTPS connections to OTEL collectors
# - libssl3: OpenSSL runtime (required by clnrm)
# NOTE: Minimal base image reduces attack surface and syscall requirements
RUN apt-get update && apt-get install -y \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user for security
# STANDARDIZATION: UID/GID fixed for deterministic behavior in gVisor sandbox
# NOTE: Non-root execution prevents privilege escalation attacks
RUN groupadd -r clnrm --gid=1000 && \
    useradd -r -g clnrm --uid=1000 --home-dir=/home/clnrm --shell=/bin/bash clnrm && \
    mkdir -p /home/clnrm /tests && \
    chown -R clnrm:clnrm /home/clnrm /tests

# Copy compiled binary from builder
COPY --from=builder /build/target/release/clnrm /usr/local/bin/clnrm

# Ensure binary is executable
# NOTE: Stripping binary removes debug symbols and reduces size for gVisor
RUN chmod +x /usr/local/bin/clnrm

# Switch to non-root user
# GENCHI GENBUTSU: Hermetic testing environment isolated from host
USER clnrm

# Set working directory for test files
WORKDIR /tests

# Configure OpenTelemetry environment variables
# NOTE: These are compatible with gVisor's network stack
# These can be overridden at runtime via docker run -e
ENV OTEL_SERVICE_NAME=clnrm-self-test \
    OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 \
    OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf \
    RUST_LOG=info \
    RUST_BACKTRACE=1

# Health check to verify clnrm binary is functional
# NOTE: gVisor supports HEALTHCHECK directive
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD ["/usr/local/bin/clnrm", "--version"]

# Set entrypoint to clnrm CLI
# Usage: docker run -v ./tests:/tests clnrm-self-test run /tests
ENTRYPOINT ["/usr/local/bin/clnrm"]

# Default command shows help
CMD ["--help"]

