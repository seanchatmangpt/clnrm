---
# ============================================================================
# ggen.toml for clnrm-cli - Generated by ggen
# ============================================================================
# Edit this file to configure CLI generation, then run: ggen project gen
# ============================================================================

rdf:
  - "../docs/clnrm-cli-v2.ttl"

sparql:
  # Project metadata
  project_info: |
    PREFIX cli: <http://ggen.dev/schema/cli#>
    
    SELECT ?name ?version ?description ?authors ?edition ?license
    WHERE {
      ?project a cli:Project ;
               cli:projectName ?name ;
               cli:projectVersion ?version ;
               cli:projectDescription ?description ;
               cli:projectAuthors ?authors ;
               cli:projectEdition ?edition ;
               cli:projectLicense ?license .
    }
    LIMIT 1

  # All nouns
  nouns: |
    PREFIX cli: <http://ggen.dev/schema/cli#>
    PREFIX cnv: <http://ggen.dev/schema/clap-noun-verb#>
    
    SELECT ?nounName ?nounDesc
    WHERE {
      ?noun a cnv:Noun ;
            cnv:nounName ?nounName ;
            cnv:nounDescription ?nounDesc .
    }
    ORDER BY ?nounName

  # All verbs
  verbs: |
    PREFIX cli: <http://ggen.dev/schema/cli#>
    PREFIX cnv: <http://ggen.dev/schema/clap-noun-verb#>
    
    SELECT ?nounName ?verbName ?verbDesc
    WHERE {
      ?noun a cnv:Noun ;
            cnv:nounName ?nounName .
      ?verb a cnv:Verb ;
            cnv:verbName ?verbName ;
            cnv:verbDescription ?verbDesc ;
            ^cnv:hasVerb ?noun .
    }
    ORDER BY ?nounName ?verbName

  # All verb arguments
  verb_arguments: |
    PREFIX cli: <http://ggen.dev/schema/cli#>
    PREFIX cnv: <http://ggen.dev/schema/clap-noun-verb#>
    
    SELECT ?nounName ?verbName ?argName ?argRequired ?argMultiple ?argPosition ?argDefault ?argHelp ?typeName
    WHERE {
      ?noun a cnv:Noun ;
            cnv:nounName ?nounName .
      ?verb a cnv:Verb ;
            cnv:verbName ?verbName ;
            ^cnv:hasVerb ?noun .
      ?arg a cnv:Argument ;
           cnv:argName ?argName ;
           cnv:argRequired ?argRequired ;
           cnv:argMultiple ?argMultiple ;
           cnv:argPosition ?argPosition ;
           cnv:argDefault ?argDefault ;
           cnv:argHelp ?argHelp ;
           cnv:hasType ?type .
      ?type cnv:typeName ?typeName .
      ?verb ^cnv:hasArgument ?arg .
    }
    ORDER BY ?nounName ?verbName ?argPosition

  # Dependencies
  dependencies: |
    PREFIX cnv: <http://ggen.dev/schema/clap-noun-verb#>
    
    SELECT ?depName ?depVersion ?features
    WHERE {
      ?dep a cnv:Dependency ;
           cnv:depName ?depName ;
           cnv:depVersion ?depVersion .
      OPTIONAL { ?dep cnv:depFeatures ?features }
    }
    ORDER BY ?depName

---

# ggen.toml Configuration
# =======================
# This file configures how ggen generates the clnrm-cli crate
# Edit the sections below and run: ggen project gen

[project]
name = "clnrm-cli"
version = "2.0.0"
description = "Cleanroom CLI - Generated from RDF definitions"

[templates]
# Template file (relative to this directory or absolute)
template = "../templates/cli-v2/cli-stack.tmpl"

# Output directory (relative to this directory)
output_dir = "src"

# Enable multi-file generation from single template
multi_output = true

[rdf]
# RDF files defining CLI structure (relative to this directory or absolute)
files = [
    "../docs/clnrm-cli-v2.ttl"
]

# SPARQL queries are defined in template frontmatter above

[generation]
# Force overwrite existing files
force = false

# Generate README
generate_readme = true

