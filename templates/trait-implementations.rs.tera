#[async_trait]
impl ServicePlugin for {{ service.rust_name }} {
    /// Start the service
    async fn start(&self) -> Result<ServiceHandle> {
        tracing::info!("Starting {{ service.name }} service");

        let container = Container::new()
            .with_image({% if service.containerImage %}"{{ service.containerImage }}"{% else %}"{{ service.containerImage | default:"alpine:latest" }}"{% endif %})
            {% if service.exposedPort %}
            .with_exposed_port({{ service.exposedPort }})
            {% endif %}
            .start()
            .await?;

        Ok(ServiceHandle {
            id: uuid::Uuid::new_v4().to_string(),
            service_name: "{{ service.name }}".to_string(),
            metadata: self.metadata.clone(),
            container: Some(container),
        })
    }

    /// Stop the service
    async fn stop(&self, handle: ServiceHandle) -> Result<()> {
        tracing::info!("Stopping {{ service.name }} service: {}", handle.id);

        if let Some(container) = handle.container {
            container.stop().await?;
        }

        Ok(())
    }

    /// Check service health
    async fn health_check(&self, handle: &ServiceHandle) -> HealthStatus {
        match handle.container {
            Some(ref container) => {
                match container.health_check().await {
                    Ok(true) => HealthStatus::Healthy,
                    Ok(false) => HealthStatus::Unhealthy,
                    Err(e) => {
                        tracing::warn!("Health check failed for {{ service.name }}: {}", e);
                        HealthStatus::Unknown
                    }
                }
            }
            None => HealthStatus::Unknown,
        }
    }
}

