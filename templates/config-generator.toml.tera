# Generated by ggen from {{ ontology_file }}
# CLNRM Test Configuration
# Auto-generated from RDF instances on {{ generation_date }}

[metadata]
name = "{{ config.testName | default:"test-config" }}"
description = "{{ config.testDescription | default:"Auto-generated test configuration" }}"
version = "1.0.0"
tags = [
    {% for tag in config.tags %}"{{ tag }}",{% endfor %}
    "generated",
    "ggen-{{ generation_date | date(format="%Y-%m-%d") }}"
]

# ==================== Services ====================

{% for service in services %}
[services.{{ service.name }}]
type = "{{ service.serviceType | default:"generic" }}"
image = "{{ service.containerImage }}"
{% if service.exposedPort %}
port = {{ service.exposedPort }}
{% endif %}

{% for env_var in service.environmentVariables %}
[services.{{ service.name }}.env]
{{ env_var.variableName }} = "{{ env_var.variableValue }}"

{% endfor %}
{% endfor %}

# ==================== Scenario ====================

[scenario]
name = "{{ scenario.name | default:"main-scenario" }}"
concurrent = {{ scenario.concurrent | default:"false" }}
service = "{{ scenario.serviceName | default:"default" }}"

{% for step in scenario.steps %}
[[scenario.steps]]
name = "{{ step.name | default:"step-" ~ loop.index0 }}"
command = ["{{ step.command | default:"echo" }}"]
{% if step.args %}
args = [{{ step.args | join:", " }}]
{% endif %}
{% if step.expectedOutput %}
expected_output = "{{ step.expectedOutput }}"
{% endif %}
{% if step.outputRegex %}
expected_output_regex = "{{ step.outputRegex }}"
{% endif %}
timeout_ms = {{ step.stepTimeout | default:"5000" }}
retries = {{ step.stepRetries | default:"0" }}

{% endfor %}

# ==================== Policy ====================

[policy]
security_level = "{{ policy.securityLevel | default:"Medium" }}"
{% if policy.resourceLimit %}
resource_limit = "{{ policy.resourceLimit }}"
{% endif %}

# ==================== Determinism ====================

[determinism]
enabled = {{ determinism.freezeClock | default:"false" }}
{% if determinism.randomSeed %}
seed = {{ determinism.randomSeed }}
{% endif %}
{% if determinism.fixedTimestamp %}
fixed_timestamp = "{{ determinism.fixedTimestamp }}"
{% endif %}

# ==================== OTEL Configuration ====================

[otel]
enabled = true
service_name = "{{ config.testName | default:"clnrm-test" }}"
deployment_environment = "development"
sample_ratio = 1.0

[otel.export]
{% if otelValidation.spanAssertion %}
span_assertion = "{{ otelValidation.spanAssertion }}"
{% endif %}
{% if otelValidation.traceAssertion %}
trace_assertion = "{{ otelValidation.traceAssertion }}"
{% endif %}
{% if otelValidation.metricAssertion %}
metric_assertion = "{{ otelValidation.metricAssertion }}"
{% endif %}

# ==================== Reports ====================

[reports]
generate_json = true
generate_junit = true
generate_html = false
output_dir = "test-reports/"

# Generated by ggen v{{ ggen_version | default:"5.0.0" }}
# Source ontology: {{ ontology_file }}
