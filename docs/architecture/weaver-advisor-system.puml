@startuml Weaver Advisor System - Detailed Architecture

!define BUILTIN_COLOR #3498DB
!define OTEL_COLOR #E74C3C
!define CUSTOM_COLOR #9B59B6
!define ADVICE_COLOR #2ECC71

title Weaver Advisor System - How Advice is Generated

' ==================== INPUT ====================
component "Normalized Sample Entity" as Sample {
    note right
        Examples:
        - input.sample.attribute
        - input.sample.span
        - input.sample.metric
        - input.sample.resource
        - input.sample.span_event
    end note
}

component "Registry Context" as RegContext {
    [input.registry_attribute]
    [input.registry_group]
    [input.registry_metric]
}

component "Preprocessed Data" as Data {
    [data.attributes]
    [data.groups]
    [data.metrics]

    note right
        Created once at startup
        via jq preprocessor.

        Improves Rego performance
        by pre-structuring registry.
    end note
}

' ==================== BUILT-IN ADVISORS ====================
package "Built-in Advisors" #BUILTIN_COLOR {
    component "missing_attribute" as MissingAttr {
        note bottom
            **Logic:**
            IF attribute not in registry
            THEN violation

            **Example:**
            container.foo_bar
            → Not in clnrm registry
            → VIOLATION
        end note
    }

    component "type_mismatch" as TypeMismatch {
        note bottom
            **Logic:**
            IF attribute.type != registry.type
            THEN violation

            **Example:**
            container.id = 123 (int)
            → Registry says string
            → VIOLATION
        end note
    }

    component "required_attribute" as RequiredAttr {
        note bottom
            **Logic:**
            IF registry.requirement_level = required
            AND attribute missing from sample
            THEN violation

            **THE CRITICAL CHECK:**
            container.id REQUIRED
            → Missing = VIOLATION
            → Proves container didn't run!
        end note
    }

    component "stability_check" as Stability {
        note bottom
            **Logic:**
            IF using experimental attr in prod
            THEN improvement

            Warns about unstable APIs.
        end note
    }
}

' ==================== OTEL ADVISORS (REGO) ====================
package "OTel Advisors (Rego Policies)" #OTEL_COLOR {
    component "namespace_check.rego" as NamespaceCheck {
        note bottom
            **Policy:**
            ```rego
            deny contains advice if {
                not regex.match("^[a-z][a-z0-9_.]*$", input.sample.attribute.name)
                advice := make_advice("invalid_namespace", "violation", ...)
            }
            ```

            Enforces OTel naming conventions.
        end note
    }

    component "format_validation.rego" as FormatVal {
        note bottom
            **Policy:**
            Checks attribute format:
            - snake_case
            - No uppercase
            - No special chars
        end note
    }

    component "naming_convention.rego" as NamingConv {
        note bottom
            **Policy:**
            Checks semantic meaning:
            - Proper namespace hierarchy
            - Consistent terminology
        end note
    }

    component "extends_namespace.rego" as ExtendsNS {
        note bottom
            **Policy:**
            ```rego
            deny contains advice if {
                extends_existing_namespace(input.sample.attribute.name)
                not has_approval(...)
                advice := make_advice("extends_namespace", "improvement", ...)
            }
            ```

            Warns when extending OTel namespaces.
        end note
    }
}

' ==================== CUSTOM ADVISORS ====================
package "Custom Advisors (User Rego)" #CUSTOM_COLOR {
    component "user_policy.rego" as UserPolicy {
        note bottom
            **Example: Reject test attrs**
            ```rego
            package live_check_advice
            import rego.v1

            deny contains make_advice(type, level, ctx, msg) if {
                input.sample.attribute
                contains(input.sample.attribute.name, "test")
                type := "contains_test"
                level := "violation"
                ctx := {"attribute_name": input.sample.attribute.name}
                msg := sprintf("Attribute must not contain 'test': %s",
                              [input.sample.attribute.name])
            }
            ```

            **clnrm Use Case:**
            - Enforce naming conventions
            - Require specific prefixes
            - Validate value ranges
            - Check attribute combinations
        end note
    }
}

' ==================== ADVICE STRUCTURE ====================
component "Advice Aggregator" as Aggregator {
    note right
        Collects advice from all advisors.
        Tracks highest level per entity.
        Accumulates statistics.
    end note
}

component "Advice Object" as AdviceObj #ADVICE_COLOR {
    [advice_level: violation|improvement|information]
    [advice_type: string]
    [signal_type: metric|span|resource]
    [signal_name: string]
    [advice_context: map]
    [message: string]

    note bottom
        **Example:**
        ```json
        {
          "advice_level": "violation",
          "advice_type": "missing_attribute",
          "signal_type": "span",
          "signal_name": "test_execution",
          "advice_context": {
            "attribute_name": "container.id",
            "requirement_level": "required"
          },
          "message": "Required attribute 'container.id' is missing from span 'test_execution'"
        }
        ```

        **This proves container didn't run!**
    end note
}

' ==================== CONNECTIONS ====================

Sample --> MissingAttr
Sample --> TypeMismatch
Sample --> RequiredAttr
Sample --> Stability

Sample --> NamespaceCheck
Sample --> FormatVal
Sample --> NamingConv
Sample --> ExtendsNS

Sample --> UserPolicy

RegContext --> MissingAttr
RegContext --> TypeMismatch
RegContext --> RequiredAttr

Data --> NamespaceCheck
Data --> FormatVal
Data --> NamingConv
Data --> ExtendsNS
Data --> UserPolicy

MissingAttr --> Aggregator : "Advice[]"
TypeMismatch --> Aggregator : "Advice[]"
RequiredAttr --> Aggregator : "Advice[]"
Stability --> Aggregator : "Advice[]"

NamespaceCheck --> Aggregator : "Advice[]"
FormatVal --> Aggregator : "Advice[]"
NamingConv --> Aggregator : "Advice[]"
ExtendsNS --> Aggregator : "Advice[]"

UserPolicy --> Aggregator : "Advice[]"

Aggregator --> AdviceObj : "Creates"

' ==================== ADVICE LEVELS ====================

note as LevelsNote #FFE5E5
    **Advice Levels (Priority Order):**

    1. **violation** (Highest)
       - Exit code 1
       - Blocks CI/CD
       - MUST fix
       - Examples:
         * missing_attribute (not in registry)
         * required_attribute (missing required)
         * type_mismatch

    2. **improvement** (Medium)
       - Exit code 0
       - Should fix
       - Examples:
         * extends_namespace
         * stability warnings

    3. **information** (Lowest)
       - Exit code 0
       - Nice to know
       - Examples:
         * usage statistics
         * best practices
end note

' ==================== THE FALSE POSITIVE PROOF ====================

note as ProofNote #E5FFE5
    **How Advisors Prevent False Positives:**

    **Scenario: Container Test**

    Schema defines:
    ```yaml
    - id: container.id
      requirement_level: required
    ```

    **Fake Implementation:**
    ```rust
    fn execute_in_container() -> Result<Output> {
        Ok(Output { stdout: "hello" })  // Fake!
    }
    ```

    **Test runs:**
    - Returns Ok(Output)
    - Test passes ✓

    **Telemetry exported:**
    - Span: test_execution
    - Attributes: test.name="foo"
    - **Missing: container.id**

    **Weaver Advisor:**
    ```
    required_attribute checker:
    IF container.id required AND missing
    THEN VIOLATION
    ```

    **Result:**
    - Advice level: violation
    - Exit code: 1
    - CI/CD: BLOCKED ✋

    **Cannot ship without proof!**
end note

@enduml
