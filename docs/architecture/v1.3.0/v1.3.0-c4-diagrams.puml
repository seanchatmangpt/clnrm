@startuml clnrm-v1.3.0-state-machine
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Code Diagram - LiveCheckOrchestrator State Machine

state "Uninitialized" as Uninit {
    state "No Weaver process" as NoProc
    state "No ports allocated" as NoPorts
    state "No coordination data" as NoCoord
}

state "Starting Weaver" as Starting {
    state "Cleanup orphans" as Cleanup
    state "Discover ports" as DiscoverPorts
    state "Spawn process" as Spawn
    state "Health check" as Health
}

state "WeaverRunning" as Running {
    state "OTLP listener active" as OTLPActive
    state "Admin endpoint ready" as AdminReady
    state "Coordination available" as CoordReady
    state "Test execution phase" as TestPhase
}

state "Stopping Weaver" as Stopping {
    state "Send SIGHUP" as SIGHUP
    state "Wait for exit" as WaitExit
    state "Timeout fallback" as TimeoutFallback
    state "Force kill" as ForceKill
}

state "Completed" as Completed {
    state "Report collected" as ReportCollected
    state "Violations analyzed" as ViolationsAnalyzed
    state "Exit code determined" as ExitCode
}

state "Error States" as Errors {
    state "Port exhaustion" as PortExhaust
    state "Health timeout" as HealthTimeout
    state "Process crash" as ProcessCrash
    state "Validation failure" as ValidationFail
}

[*] --> Uninit

Uninit --> Starting : start_and_coordinate()
Starting --> Cleanup : begin
Cleanup --> DiscoverPorts : orphans removed
DiscoverPorts --> Spawn : ports found
DiscoverPorts --> PortExhaust : all tiers exhausted
Spawn --> Health : process started
Health --> Running : health check passed
Health --> HealthTimeout : timeout (30s)
Health --> ProcessCrash : process exited

Running --> TestPhase : coordination returned
TestPhase --> Stopping : stop_and_report()

Stopping --> SIGHUP : graceful shutdown
SIGHUP --> WaitExit : signal sent
WaitExit --> Completed : process exited
WaitExit --> TimeoutFallback : timeout (10s)
TimeoutFallback --> ForceKill : SIGKILL
ForceKill --> Completed : process killed

Completed --> ReportCollected : report parsed
ReportCollected --> ViolationsAnalyzed : JSON analyzed
ViolationsAnalyzed --> ExitCode : exit code set
ExitCode --> [*]

' Error transitions
PortExhaust --> Errors : fail
HealthTimeout --> Errors : fail
ProcessCrash --> Errors : fail
ViolationsAnalyzed --> ValidationFail : violations > 0
ValidationFail --> Errors : fail

Errors --> [*] : error exit

note right of Starting
    **Port Discovery Strategy:**
    1. Try tier 1 (4317-4327, 8080-8089)
    2. Fallback tier 2 (5317-5327, 9080-9089)
    3. Extended tier 3 (6317-6337, 10080-10099)
    4. Fail if all exhausted
end note

note right of Running
    **Coordination Data:**
    - weaver_pid: u32
    - otlp_grpc_port: u16
    - admin_port: u16
    - ready_at: Instant

    Used to configure OTEL exporters
end note

note right of Stopping
    **Graceful Shutdown:**
    Unix: SIGHUP signal
    Windows: kill process

    Timeout: 10 seconds
    Fallback: SIGKILL
end note

note right of Completed
    **Critical Checks:**
    1. Report exists?
    2. Sample count > 0?
    3. Violations > 0?

    Zero samples = FAILURE
    (no telemetry = broken test)
end note

@enduml

