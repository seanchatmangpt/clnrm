@startuml Weaver Live Check - Complete Architecture

!define INPUT_COLOR #3498DB
!define INGESTER_COLOR #9B59B6
!define ADVISOR_COLOR #E74C3C
!define OUTPUT_COLOR #2ECC71
!define REGISTRY_COLOR #F39C12

title Weaver Live Check - Complete Architecture (clnrm v1.2.0 Integration)

' ==================== INPUT LAYER ====================
package "Input Layer" #INPUT_COLOR {
    interface "OTLP gRPC\n:4317" as OTLPgRPC {
        note right
            **PRIMARY for clnrm**
            Receives protobuf
            encoded spans
        end note
    }

    interface "OTLP HTTP\n:4318" as OTLPHTTP

    interface "File Input\n(JSON/Text)" as FileInput {
        note right
            For testing with
            captured telemetry
        end note
    }

    interface "stdin\n(Streaming)" as StdIn
}

' ==================== INGESTER LAYER ====================
package "Ingester Layer" #INGESTER_COLOR {
    component "OTLP Ingester" as OTLPIng {
        [gRPC Receiver]
        [HTTP Receiver]
        [Protobuf Decoder]
        [Stream Processor]

        note bottom
            **Stop Conditions:**
            - CTRL+C (SIGINT)
            - SIGHUP
            - HTTP /stop endpoint
            - Inactivity timeout
        end note
    }

    component "File Ingester" as FileIng {
        [JSON Parser]
        [Text Parser]
        [Batch Loader]
    }

    component "Stdin Ingester" as StdInIng {
        [Line Reader]
        [JSON Stream Parser]
        [Attribute Parser]
    }

    component "Sample Normalizer" as Normalizer {
        [Type Detection]
        [Structure Mapping]
        [Context Enrichment]

        note right
            Transforms all inputs
            to common format:
            - Spans
            - Metrics
            - Resources
            - Events
            - Attributes
        end note
    }
}

' ==================== REGISTRY LAYER ====================
package "Registry Layer" #REGISTRY_COLOR {
    database "Semantic Convention\nRegistry" as Registry {
        folder "clnrm Registry" {
            [core/]
            [metrics/]
            [events/]
            [registry_manifest.yaml]
        }

        note bottom
            **clnrm v1.2.0:**
            - 14 schema files
            - 200+ entities
            - Zero warnings
            - 100% valid
        end note
    }

    component "Registry Loader" as Loader {
        [YAML Parser]
        [Schema Validator]
        [Entity Index]
        [Attribute Map]
    }

    component "jq Preprocessor" as JQ {
        [Registry Transform]
        [Data Structure]
        [Rego Data Prep]

        note right
            Preprocesses registry
            once for Rego policies.
            Improves performance.
        end note
    }
}

' ==================== ADVISOR LAYER ====================
package "Advisor Layer" #ADVISOR_COLOR {
    component "Built-in Advisors" as BuiltIn {
        [missing_attribute]
        [type_mismatch]
        [required_attribute]
        [stability_check]

        note right
            **Cannot be faked:**
            - Required attrs MUST exist
            - Types MUST match
            - Stability MUST be valid

            **Proof, not assumption**
        end note
    }

    component "OTel Advisors\n(Rego)" as OTelAdv {
        [namespace_check.rego]
        [format_validation.rego]
        [naming_convention.rego]
        [extends_namespace.rego]
        [illegal_namespace.rego]

        note bottom
            Default OTel policies
            included out-of-box.
            Can be overridden.
        end note
    }

    component "Custom Advisors\n(User Rego)" as CustomAdv {
        [user_policy_1.rego]
        [user_policy_2.rego]
        [...]

        note bottom
            --advice-policies DIR

            Must use package:
            live_check_advice
        end note
    }

    component "Advice Aggregator" as Aggregator {
        [Per-Entity Advice]
        [Highest Level Tracking]
        [Statistics Accumulation]
        [Coverage Calculation]
    }
}

' ==================== OUTPUT LAYER ====================
package "Output Layer" #OUTPUT_COLOR {
    component "Template Engine\n(Jinja2)" as Templates {
        [ANSI Formatter]
        [JSON Formatter]
        [Custom Templates]

        note right
            --templates DIR
            --format [ansi|json]
        end note
    }

    component "Statistics Generator" as Stats {
        [Advice Counts]
        [Coverage Calculation]
        [Registry Usage]
        [Entity Tracking]

        note bottom
            Generated on input close:
            - advice_level_counts
            - advice_type_counts
            - registry_coverage
            - seen_registry_attributes
            - seen_non_registry_attributes
        end note
    }

    component "Output Writer" as Writer {
        [stdout Stream]
        [File Writer]
        [Directory Writer]

        note right
            Default: stdout
            --output FILE
            --output DIR/

            Streaming vs Batch
        end note
    }

    component "Exit Code Logic" as ExitCode {
        note right
            **CI/CD Gate:**
            Exit 0 = No violations
            Exit 1 = Violations found

            Blocks bad code!
        end note
    }
}

' ==================== ADMIN INTERFACE ====================
component "Admin HTTP\n:8080" as Admin {
    [POST /stop]
    [GET /health]

    note bottom
        Used by CI/CD:
        kill -HUP PID
        OR
        curl -X POST :8080/stop
    end note
}

' ==================== CONNECTIONS ====================

' Input to Ingesters
OTLPgRPC --> OTLPIng : "OTLP\nProtobuf"
OTLPHTTP --> OTLPIng
FileInput --> FileIng : "Batch"
StdIn --> StdInIng : "Stream"

' Ingesters to Normalizer
OTLPIng --> Normalizer : "Raw\nMessages"
FileIng --> Normalizer
StdInIng --> Normalizer

' Registry Flow
Registry --> Loader : "Load at\nStartup"
Loader --> JQ : "Raw\nRegistry"
JQ --> BuiltIn : "Schema\nDefinitions"
JQ --> OTelAdv : "data{}\nfor Rego"
JQ --> CustomAdv : "data{}\nfor Rego"

' Normalized to Advisors
Normalizer --> BuiltIn : "input.sample.*"
Normalizer --> OTelAdv : "input.sample.*"
Normalizer --> CustomAdv : "input.sample.*"

Loader --> BuiltIn : "Registry\nContext"
Loader --> OTelAdv : "input.registry_*"
Loader --> CustomAdv : "input.registry_*"

' Advisors to Aggregator
BuiltIn --> Aggregator : "Advice[]"
OTelAdv --> Aggregator : "Advice[]"
CustomAdv --> Aggregator : "Advice[]"

' Aggregation to Output
Aggregator --> Templates : "Annotated\nEntities"
Aggregator --> Stats : "Accumulation\nData"

' Output Generation
Templates --> Writer : "Formatted\nStream"
Stats --> Writer : "Statistics\nJSON"

' Exit Code
Aggregator --> ExitCode : "Check\nViolations"
ExitCode --> Writer : "Set Exit\nCode"

' Admin Interface
OTLPIng <-- Admin : "Control"

' ==================== THE CRITICAL PATH ====================

note as CriticalPath #FFE5E5
    **THE CRITICAL PATH FOR clnrm v1.2.0**

    1. Test creates span with attributes
       ↓
    2. OTel SDK batches span
       ↓
    3. OTLP Exporter sends to :4317 (gRPC)
       ↓
    4. Weaver OTLP Ingester receives
       ↓
    5. Normalizer extracts entities
       ↓
    6. Advisors check against registry
       ↓
    7. Violations = Required attrs missing
       ↓
    8. Exit 1 = FAIL = Block merge

    **FALSE POSITIVE IMPOSSIBLE:**
    - container.id REQUIRED → Must come from real Docker
    - test.isolated REQUIRED → Must prove hermetic execution
    - plugin.execution_time_ms REQUIRED → Must prove plugin ran
end note

' ==================== STREAMING VS BATCH ====================

note as StreamingNote #E5F5FF
    **Streaming Mode (Default OTLP):**
    - Output advice as telemetry arrives
    - Great for live debugging
    - Use --no-stream to disable

    **Batch Mode (Files):**
    - Load all data
    - Process in one pass
    - Single report at end

    **Auto-Batch:**
    - If --output is DIR, auto-batch
    - If --output is FILE, can stream
end note

@enduml
