@startuml Weaver Statistics and Coverage Calculation

!define INPUT_COLOR #3498DB
!define CALC_COLOR #E74C3C
!define OUTPUT_COLOR #2ECC71

title Weaver Statistics Generation - How Coverage is Calculated

' ==================== INPUT DATA ====================
component "Accumulated Data" as Accum {
    [All Processed Entities]
    [All Advice Generated]
    [Registry Definitions]
}

note right of Accum
    Collected during entire
    live-check session:
    - Every span processed
    - Every attribute seen
    - Every advice generated
end note

' ==================== CALCULATION COMPONENTS ====================
package "Statistics Calculator" #CALC_COLOR {

    component "Entity Counter" as EntityCount {
        note right
            **Counts:**
            ```rust
            total_entities: usize
            total_entities_by_type: {
                "attribute": count,
                "span": count,
                "metric": count,
                "resource": count,
                "span_event": count
            }
            ```
        end note
    }

    component "Advice Aggregator" as AdviceAgg {
        note right
            **Aggregates:**
            ```rust
            advice_level_counts: {
                "violation": count,
                "improvement": count,
                "information": count
            }

            advice_type_counts: {
                "missing_attribute": count,
                "type_mismatch": count,
                "required_attribute": count,
                ...
            }

            highest_advice_level_counts: {
                "violation": count,  // Entities with violation as highest
                "improvement": count,
                "information": count
            }
            ```

            **highest_advice_level:**
            Per entity, track the WORST advice.
            If entity has both "information" and "violation",
            count it as "violation".
        end note
    }

    component "Coverage Calculator" as Coverage {
        note right
            **Formula:**
            ```rust
            registry_coverage =
                seen_registry_entities /
                total_registry_entities

            Example:
            42 attrs seen out of 50 total = 0.84
            ```

            **Interpretation:**
            - 1.0 = 100% coverage (perfect)
            - 0.85 = 85% coverage (excellent)
            - 0.50 = 50% coverage (needs work)
            - 0.10 = 10% coverage (poor)
        end note
    }

    component "Attribute Tracker" as AttrTracker {
        note right
            **Tracks:**
            ```rust
            seen_registry_attributes: {
                "container.id": 15,  // Seen 15 times
                "container.image": 15,
                "test.isolated": 15,
                "plugin.name": 3,
                "command": 0,  // In registry but never seen
                ...
            }

            seen_non_registry_attributes: {
                "custom.foo": 5,  // Not in registry
                "debug.bar": 2,
                ...
            }
            ```

            **Use cases:**
            - Identify unused schema definitions
            - Find custom attributes (extend registry?)
            - Validate instrumentation completeness
        end note
    }

    component "Metric Tracker" as MetricTracker {
        note right
            **Similar to attributes:**
            ```rust
            seen_registry_metrics: {
                "http.client.request.duration": 100,
                "system.cpu.utilization": 0,
                ...
            }

            seen_non_registry_metrics: {
                "custom.request.count": 50,
                ...
            }
            ```
        end note
    }

    component "No Advice Counter" as NoAdvice {
        note right
            **Counts entities with zero advice:**
            ```rust
            no_advice_count: usize
            ```

            High count = Good instrumentation!
            Low count = Many issues found
        end note
    }
}

